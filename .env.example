# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...
FROM_EMAIL=hello@vikashan.com.au
FROM_NAME=Vikashan

# Admin auth
ADMIN_EMAIL=vik@vikashan.com.au
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Cron security
CRON_SECRET=

# Zoom — paste your personal room link
ZOOM_PERSONAL_LINK=https://zoom.us/j/your-personal-room-id

# Kit / ConvertKit (optional)
KIT_API_KEY=
KIT_LIST_ID=

# Public URL
NEXT_PUBLIC_URL=https://vikashan.com.au

# New Page member app (/newpage/app)
# Powers the Career Coach chat. Without it, everything else still works and the coach says it isn't switched on.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
NEWPAGE_COACH_MODEL=

# Career Reading (reading.vikashan.org). Uses ANTHROPIC_API_KEY, the Supabase,
# Stripe, Resend and CRON_SECRET settings above. See reading/README.md.
# Set to 1 to make readings free (no Stripe), for testing.
READING_FREE=
# Price in cents, and currency. Defaults: 4900, aud.
READING_PRICE_CENTS=
READING_CURRENCY=
# Where readings live; used in emails and Stripe return links.
READING_URL=https://reading.vikashan.org
# Optional: models and effort. Defaults: claude-opus-5-5, claude-haiku-5-5, low.
READING_MODEL=
READING_QUICK_MODEL=
READING_EFFORT=
# Optional: seconds per writing batch (keep below maxDuration in vercel.json), steps at once, days kept.
READING_WORK_SECONDS=
READING_CONCURRENCY=
READING_KEEP_DAYS=
