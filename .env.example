# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...
FROM_EMAIL=hello@vikashan.com.au
FROM_NAME=Vikashan

# Admin auth
ADMIN_EMAIL=vik@vikashan.com.au
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Cron security
CRON_SECRET=

# Zoom — paste your personal room link
ZOOM_PERSONAL_LINK=https://zoom.us/j/your-personal-room-id

# Kit / ConvertKit (optional)
KIT_API_KEY=
KIT_LIST_ID=

# Public URL
NEXT_PUBLIC_URL=https://vikashan.com.au

# New Page member app (/newpage/app)
# Powers the Career Coach chat and the writers (resume, cover letter, Compass...). Without it, everything else still works and they say they aren't switched on.
ANTHROPIC_API_KEY=
# Optional. Coach and the other writers; defaults to claude-sonnet-5-5.
NEWPAGE_COACH_MODEL=
# Optional. The resume writer (api/newpage/resume.py); defaults to claude-opus-5-5. RESUME_EFFORT defaults to medium.
RESUME_MODEL=
# Optional. Set to off to stop re-running declined requests on a fallback model (server-side refusal fallback).
NEWPAGE_FALLBACKS=
RESUME_FALLBACKS=
